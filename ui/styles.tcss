/* ========== GLOBAL ========== */
Screen {
    align: center middle;
    background: #070b14;
}

/* ========== MAIN MENU ========== */
#menu {
    width: 64;
    height: auto;
    padding: 2 3;
    background: #0f172a;
    border: tall #00e5ff;
    border-title-color: #00e5ff;
}

#title {
    content-align: center middle;
    color: #00e5ff;
    text-style: bold;
    height: 3;
    text-opacity: 100%;
}

#subtitle {
    content-align: center middle;
    color: #94a3b8;
    height: 2;
    margin-bottom: 1;
}

#line {
    content-align: center middle;
    color: #1e3a5f;
    height: 1;
    margin-bottom: 1;
}

/* ========== BUTTONS ========== */
Button {
    width: 100%;
    height: 3;
    margin: 1 0;
    background: #1e293b;
    color: #e2e8f0;
    border: round #334155;
    text-style: bold;
}

Button:hover {
    background: #00b4d8;
    color: #020617;
    border: round #00e5ff;
    text-style: bold;
}

Button:focus {
    background: #0096c7;
    color: #f8fafc;
    border: heavy #00e5ff;
    text-style: bold;
}

/* Special Exit Button */
#exit-btn {
    background: #7f1d1d;
    border: round #dc2626;
    color: #fecaca;
}

#exit-btn:hover {
    background: #ef4444;
    color: white;
    border: round #f87171;
}

#exit-btn:focus {
    background: #b91c1c;
    color: white;
    border: heavy #f87171;
}

#footer {
    content-align: center middle;
    color: #64748b;
    height: 2;
    margin-top: 1;
}

/* ========== OTHER SCREENS ========== */
.screen-panel {
    width: 72;
    height: auto;
    padding: 2 4;
    background: #0f172a;
    border: tall #00e5ff;
}

.screen-title {
    content-align: center middle;
    color: #00e5ff;
    text-style: bold;
    height: 3;
    margin-bottom: 1;
}

.screen-content {
    color: #e2e8f0;
    margin: 1 0;
    padding-left: 1;
}

#back {
    width: 32;
    height: 3;
    margin-top: 2;
    background: #0ea5e9;
    color: white;
    border: round #38bdf8;
    text-style: bold;
}

#back:hover {
    background: #38bdf8;
    color: #0f172a;
    border: round #7dd3fc;
}

#back:focus {
    background: #0284c7;
    color: white;
    border: heavy #38bdf8;
}